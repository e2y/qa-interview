{
  "name": "qa-bdd-interview-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A small TypeScript T-shirt shop for discussing QA, Cucumber, and Playwright",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "npm run build && node dist/app/server.js",
    "install:browser": "playwright install chromium",
    "test": "npm run build && start-server-and-test 'node dist/app/server.js' http://127.0.0.1:4173/ 'cucumber-js --config cucumber.json'",
    "test:features": "npm run build && cucumber-js --config cucumber.json"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "^26.0.0",
    "playwright": "1.56.1",
    "start-server-and-test": "2.0.13",
    "typescript": "^5.9.3"
  }
}
